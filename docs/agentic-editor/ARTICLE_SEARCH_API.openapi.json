{
  "openapi": "3.1.0",
  "info": {
    "title": "Agentic AI Editor Article Read API",
    "version": "2.0.0",
    "description": "Hardened server-to-server contract. Deploy the hardening release and provision a token before use. Article-read application tokens use explicit all_regions/article_metros scope, expire after 90 days, and can be revoked. Editorial tokens require an approved bound user. Do not send a caller-selected user_id."
  },
  "servers": [
    {
      "url": "https://editor.agentictopic.com",
      "description": "Production HTTPS origin"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local development only"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/api/articles/search": {
      "get": {
        "summary": "Search editorial and original titles",
        "operationId": "searchArticles",
        "description": "Case-insensitive literal substring match on hl_title OR title. Non-archived records only; bound actor region scope applies. Results ordered by local ID ascending.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "description": "Trimmed title substring; SQL wildcard characters are literal."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 999999999
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 1,
              "maximum": 200
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "deprecated": true,
            "schema": {
              "type": "integer"
            },
            "description": "Omit. Application credentials reject this parameter. For a user-bound client only, it must exactly match that client's user."
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid query or pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, revoked, disabled, or unbound credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer"
              }
            }
          },
          "403": {
            "description": "Actor mismatch or insufficient client access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "description": "Seconds until next minute; present for the shared client limit, absent for the IP limit."
              }
            }
          },
          "503": {
            "description": "Shared rate-limit service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Full matching records and pagination; an empty result is successful.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/articles/{id}": {
      "get": {
        "summary": "Retrieve one full article by local ID",
        "operationId": "getArticle",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Local id from a search result, not a CMS reference."
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "deprecated": true,
            "schema": {
              "type": "integer"
            },
            "description": "Omit. Application credentials reject this parameter. For a user-bound client only, it must exactly match that client's user."
          }
        ],
        "responses": {
          "401": {
            "description": "Invalid, expired, revoked, disabled, or unbound credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string"
                },
                "description": "Bearer"
              }
            }
          },
          "403": {
            "description": "Actor mismatch or insufficient client access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Absent, archived, or out-of-scope article",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "description": "Seconds until next minute; present for the shared client limit, absent for the IP limit."
              }
            }
          },
          "503": {
            "description": "Shared rate-limit service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "200": {
            "description": "Article object directly, without a wrapper.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Article"
                }
              }
            }
          }
        }
      }
    }
  },
